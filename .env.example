# Copy this file to .env ON THE SERVER (do not overwrite existing local credentials).
# No scheme, trailing slash, or path. Caddy provisions HTTPS for this hostname.
SITE_ADDRESS=tracker.example.org

FRONTEND_IMAGE=gcam-tracker-frontend:1.0.0
BACKEND_IMAGE=gcam-tracker-backend:1.0.0

BASIC_AUTH_USER=research
# Generate with: docker run --rm -it caddy:2-alpine caddy hash-password
# Keep single quotes around the hash so Compose preserves literal dollar signs.
BASIC_AUTH_HASH=''

# Generate with: openssl rand -hex 32
INGEST_TOKEN=

GOOGLE_SHEET_ID=
DRIVE_CONFIGS_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_INPUTS_FOLDER_ID=

# The service-account JSON is a separate file: secrets/google-service-account.json
# It is mounted only into the backend. Never paste credentials into an image.
